# The lifecycle agent: `python -m rhi_lifecycle`, the release's agent, on Python 3.13 (system
# design, "What happens on an instance"). The boot program starts it at every start of the
# instance.
#
# The image is the official Python image, named by the digest of its multi-platform index: the
# reference of the repository's Dockerfiles. The agent and its libraries are pure Python, so the
# one folder of the release runs on every pool, and the docker of each pool's host takes its own
# platform from the index.
#
# What the agent's container is given:
# - the release's agent, read-only, as its working directory, where Python finds the modules;
# - every variable of /run/rhi/release.env, as the boot program wrote it;
# - /run/rhi, where it keeps the record of the current start;
# - /var/lib/rhi, read-only, where its program reads the record of the release the instance holds;
# - the host's network: the instance metadata, the engine on the loopback address, and its own
#   metrics there, on port 9110;
# - the host's process namespace and its privileges: the agent runs the host's systemctl and
#   docker, with nsenter on the host's first process (rhi_lifecycle.host).

[Unit]
Description=The lifecycle agent: the instance's transitions and its duties
Requires=docker.service
After=docker.service

[Service]
EnvironmentFile=/run/rhi/release.env
ExecStartPre=-/usr/bin/docker rm --force rhi-lifecycle
ExecStart=/usr/bin/docker run --rm --name rhi-lifecycle --network host --pid host --privileged \
    --env-file /run/rhi/release.env \
    --volume /opt/rhi/release/agent:/opt/rhi/release/agent:ro \
    --volume /run/rhi:/run/rhi \
    --volume /var/lib/rhi:/var/lib/rhi:ro \
    --workdir /opt/rhi/release/agent \
    python:3.13.14-slim-trixie@sha256:9662417aace5ae7b8e2609cce472b72a8958e134ba372808abe9cc1a0c0125e6 \
    python -m rhi_lifecycle
ExecStop=/usr/bin/docker stop rhi-lifecycle
Restart=on-failure
RestartSec=5
